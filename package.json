{
  "name": "constrictor-rest-client",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend:wait\"",
    "dev:backend": "go run cmd/constrictor-rest-client/main.go",
    "dev:frontend": "cd web && npm run dev",
    "dev:frontend:wait": "sleep 3 && cd web && npm run dev",
    "install:all": "npm install && go mod tidy && cd web && npm install",
    "test": "go test ./...",
    "build": "cd web && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
